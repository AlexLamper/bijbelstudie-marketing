# Non-secret engine settings (committed). Secrets live in GitHub Actions secrets
# (MONGODB_URI, ENGINE_KEY, later the platform tokens), in Vercel env vars for the studio,
# and - only when you run the engine on your own machine - in .env.engine (gitignored).
# Per-project settings (database, colours, logos, end card) are in projects/<id>/project.json.
DEFAULT_PROJECT=bijbelstudie
STUDIO_URL=https://al-marketing-studio.vercel.app
