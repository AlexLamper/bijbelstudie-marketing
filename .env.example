# Copy to .env.local for the studio (npm run dev). In production these live in Vercel env vars
# (studio) and GitHub Actions secrets (engine). Never commit real values.

# --- shared ---
MONGODB_URI=mongodb+srv://...            # marketing database (Atlas M0 free is enough)
MONGODB_DB=bijbelstudie_marketing

# --- studio (Next.js) ---
STUDIO_PASSWORD=                         # the one password to open the studio
GITHUB_REPO=AlexLamper/bijbelstudie-marketing
GITHUB_DISPATCH_TOKEN=                   # fine-grained PAT, this repo only, Contents: read and write

# --- brain ---
CLAUDE_CODE_OAUTH_TOKEN=                 # from `claude setup-token` (uses your Claude Pro/Max plan)

# --- media storage (Cloudflare R2, free tier) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=bijbelstudie-media
R2_PUBLIC_URL=https://pub-xxxx.r2.dev    # or a custom domain

# --- voice (one of the two) ---
GOOGLE_TTS_API_KEY=                      # free tier: 1M chars/month Chirp 3 HD
GOOGLE_TTS_VOICE_MALE=nl-NL-Chirp3-HD-Charon
GOOGLE_TTS_VOICE_FEMALE=nl-NL-Chirp3-HD-Aoede
ELEVENLABS_API_KEY=                      # optional, ~$6/month, takes precedence when set
ELEVENLABS_VOICE_MALE=
ELEVENLABS_VOICE_FEMALE=

# --- Instagram + Facebook ---
META_GRAPH_VERSION=v23.0
META_PAGE_TOKEN=                         # long-lived Page token
IG_USER_ID=
FB_PAGE_ID=

# --- YouTube Shorts ---
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=

# --- TikTok (official API, or the Upload-Post bridge) ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://www.bijbelstudie.io/
TIKTOK_REFRESH_TOKEN=
UPLOADPOST_API_KEY=
UPLOADPOST_USER=

# --- notifications + growth metric ---
RESEND_API_KEY=
NOTIFY_TO=info@bijbelstudie.io
NOTIFY_FROM=BijbelStudie Studio <studio@bijbelstudie.io>
DASHBOARD_URL=https://studio.bijbelstudie.io
PLATFORM_MONGODB_URI=                    # read-only user on the BijbelStudie platform database (signups)
PLATFORM_MONGODB_DB=
